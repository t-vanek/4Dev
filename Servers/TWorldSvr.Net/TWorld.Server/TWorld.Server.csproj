<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TWorld.Server</RootNamespace>
    <AssemblyName>TWorld.Server</AssemblyName>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <!-- Microsoft.Data.SqlClient requires ICU; invariant globalization is unsupported. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TWorld.Protocol\TWorld.Protocol.csproj" />
    <ProjectReference Include="..\TWorld.Data\TWorld.Data.csproj" />
    <ProjectReference Include="..\..\FourDev.Mail\FourDev.Mail.csproj" />
  </ItemGroup>

</Project>
